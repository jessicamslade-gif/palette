# Copy this file to .env.local for local dev, and set the same values
# as Environment Variables in your Vercel project settings.

SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# This is your personal password for the web app AND the value you'll
# paste into the Chrome extension's Settings as the API key.
APP_SECRET=choose-a-long-random-password
